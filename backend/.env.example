APP_NAME="FnB Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fb_multicompany
DB_USERNAME=postgres
DB_PASSWORD=
# Role PostgreSQL tanpa hak BYPASSRLS yang dipakai aplikasi saat melayani request tenant.
DB_RLS_ROLE=fnb_app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@fnbcloud.test"
MAIL_FROM_NAME="${APP_NAME}"

# Daftar akun demo di halaman login (hanya untuk demo, jangan aktifkan di produksi)
FNB_DEMO_LOGIN=false

# Keamanan
SANCTUM_TOKEN_EXPIRATION=720
FNB_LOGIN_MAX_ATTEMPTS=5
FNB_LOGIN_LOCK_MINUTES=15
FNB_PIN_MAX_ATTEMPTS=5
FNB_PIN_LOCK_MINUTES=15
FNB_PIN_HASH_ROUNDS=10
FNB_PAIRING_CODE_TTL=15
FNB_SUBSCRIPTION_GRACE_DAYS=7

VITE_APP_NAME="${APP_NAME}"

# Payment gateway (Tahap 3). Mitra produksi belum dipilih; sandbox hanya untuk local/testing/staging.
PAYMENT_GATEWAY=sandbox
PAYMENT_SANDBOX_SECRET=
PAYMENT_INTENT_TTL=15
